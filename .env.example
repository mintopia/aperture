APP_NAME=Aperture
APP_ENV=local
APP_KEY=
APP_DEBUG=true
PUBLIC_APP_HOSTNAME=hallowed-rincewind.ws.cloudagent.mintopia.net
PUBLIC_REVERB_HOSTNAME=reverb.hallowed-rincewind.ws.cloudagent.mintopia.net
PUBLIC_VITE_HOSTNAME=vite.hallowed-rincewind.ws.cloudagent.mintopia.net
APP_URL=https://${PUBLIC_APP_HOSTNAME}

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=aperture
DB_USERNAME=aperture
DB_PASSWORD=aperture

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_APP_ID=aperture
REVERB_APP_KEY=aperture
REVERB_APP_SECRET=swordfish
REVERB_SERVER_HOST=reverb
REVERB_SERVER_PORT=8080
REVERB_PORT=8080
REVERB_HOST=reverb
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${PUBLIC_REVERB_HOSTNAME}"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME="https"

VITE_HMR_HOST="${PUBLIC_VITE_HOSTNAME}"
VITE_HMR_PORT=443
VITE_HMR_PROTOCOL="wss"
