APP_NAME=Aperture
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://aperture.example.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=aperture
DB_USERNAME=aperture
DB_PASSWORD=secret

BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=604800

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Reverb (WebSockets)
REVERB_APP_ID=aperture
REVERB_APP_KEY=aperture
REVERB_APP_SECRET=change-me
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_PORT=8080
REVERB_HOST=reverb
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=aperture.example.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Vite HMR (local dev only)
VITE_HMR_HOST=aperture.example.com
VITE_HMR_PORT=443
VITE_HMR_PROTOCOL=wss

# SSH Proxy (switch management — required, the only switch transport)
APERTURE_SSH_PROXY_HOST=127.0.0.1
APERTURE_SSH_PROXY_PORT=8022
APERTURE_SSH_PROXY_API_KEY=change-me

# Tuning
#APERTURE_SESSION_TTL=432000
#APERTURE_SWITCH_SYNC_INTERVAL=300
#APERTURE_CIRCUIT_BREAKER_THRESHOLD=5
#APERTURE_CIRCUIT_BREAKER_COOLDOWN=300
#APERTURE_BANDWIDTH_ANOMALY_THRESHOLD=3.0
#EVENT_RETENTION_DAYS=30
